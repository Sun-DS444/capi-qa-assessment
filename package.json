{
  "name": "capi-qa-assessment",
  "version": "1.0.0",
  "private": true,
  "description": "QA take-home: offline sync API tests, dynamic skip-logic web tests, schema contract checks",
  "scripts": {
    "mock-server": "node mock-server/server.js",
    "test": "playwright test",
